# Base URL for the FastAPI backend.
# Leave as localhost for local dev — the browser uses /api (Next.js proxy) instead,
# so phones only need port 3000, not 8000 through the firewall.
# For production (Vercel + separate API host), set your deployed backend URL:
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com
NEXT_PUBLIC_API_URL=https://leafscan-app.onrender.com/
