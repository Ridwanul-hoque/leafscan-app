# Comma-separated list of allowed origins for browser requests.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where the trained weights file lives.
# Relative paths are resolved from the backend/ working directory.
MODEL_PATH=models/hybrid_effnet_mobilenet_distill_final.weights.h5

# Where the ordered class label list lives. Must be a JSON array of strings
# whose length matches the model's softmax dimension. See
# app/data/class_labels.README.md for how to populate it.
CLASS_LABELS_PATH=app/data/class_labels.json

# App-layer validation (no model retrain). Reject uploads when the HSV leaf
# mask finds too little plant tissue, or softmax confidence is too low.
MIN_LEAF_COVERAGE=0.08
MIN_CONFIDENCE=0.55
